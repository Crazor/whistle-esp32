# Same board settings as needle_demo -- see the README's Troubleshooting.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Same table as needle_demo, so app-flash leaves the model partition alone.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../needle_demo/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# This board is plugged in by its native USB port, not the UART bridge. With
# the default (UART0 primary, USB mirror), every printf also busy-waits on
# UART0 at 115200 baud: dumping one clip took over a minute and starved the
# idle task. Primary USB-Serial/JTAG runs at USB speed and accepts input.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
